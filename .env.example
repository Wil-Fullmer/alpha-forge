# Financial Modeling Prep API
FMP_API_KEY=your_api_key_here

# Application
NODE_ENV=development
LOG_LEVEL=info

# Web Server (if using)
PORT=3000
HOST=localhost

# Data Pipeline
CACHE_ENABLED=true
CACHE_TTL=3600
ANALYSIS_CACHE_TTL_MS=86400000   # How long data/{TICKER}-analysis.json is reused (ms). Default: 24h
MAX_PROVIDER_CALLS=20             # Warn when provider API calls exceed this count per session
