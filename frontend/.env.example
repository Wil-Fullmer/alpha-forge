# Alpha Forge — frontend environment variables
# Copy this file to .env.local and fill in values for your environment.
# .env.local is gitignored and never committed.

# --- Backend mode ---
# Set VITE_API_URL to the real backend's base URL to enable backend mode.
# Frontend sends requests directly to this URL (CORS is open on the backend).
# When unset (default), fixture mode is active and requests go through the Vite proxy.
#
# VITE_API_URL=http://localhost:3000

# --- Fixture mode (default) ---
# When VITE_API_URL is unset, the Vite dev server proxies /api/* to VITE_PROXY_TARGET.
# Default is http://localhost:3001 (fixture server). Override only if you run the
# fixture server on a different port.
#
# VITE_PROXY_TARGET=http://localhost:3001
